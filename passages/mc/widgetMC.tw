:: widgetMC [widget nobr] {"position":"1975,1325","size":"100,100"}
<<widget "lvlStar">>
	/* Sidebar level icon doubling as an XP gauge: a desaturated base
	   star (always visible) with a full-color copy clipped from the top
	   by (100 - pct)% so it fills bottom-up as XP accumulates toward
	   the next level. Pure CSS overlay — both layers share lvl.png. */
	<<set _lvlPct to Math.max(0, Math.min(100, Math.floor((setup.Mc.exp() / setup.Mc.neededForNextLevel()) * 100)))>>
	<<set _lvlClip to 100 - _lvlPct>>
	<span class="lvl-star" @title="'XP ' + setup.Mc.exp() + ' / ' + setup.Mc.neededForNextLevel() + ' (' + _lvlPct + '%)'">
		<<image "ui/icons/lvl.png" { class: "lvl-star-base" }>>
		<<image "ui/icons/lvl.png" { class: "lvl-star-fill", style: "clip-path: inset(" + _lvlClip + "% 0 0 0); -webkit-clip-path: inset(" + _lvlClip + "% 0 0 0);" }>>
	</span>
<</widget>>

<<widget "gainXP">>
	<<if not setup.Flashbacks.isReplaying()>>
		<<set _xpAmount to _args[0]>>
		<<set _xpCorruption to _args[1]>>
		<<set _xpMoney to _args[2]>>
		<div class="wrapperGain">
		<span>You gain:</span><br>
		<<if _xpMoney>>
			<span> Money: +<<= _xpMoney>>$ </span><br>
			<<run setup.Mc.addMoney(_xpMoney)>>
		<</if>>
		<span>Experience: +<<= _xpAmount>> exp</span><br>
		<<if _xpCorruption>>
			<<if setup.Mc.corruption() lt 10>>
				<<run setup.Mc.addCorruption(_xpCorruption)>>
				<span><<statIcon setup.StatIcon.CORRUPTION>>: +<<= _xpCorruption>> </span>
			<</if>>
		<</if>>
		<span class="reachedNewLvl"></span><br>
		</div>
		<span id="expBar"><<showmeter 'xpBar'>></span><br>
		<<set _leveled to setup.Mc.grantExp(_xpAmount)>>
		<<updatemeter 'xpBar' `setup.Mc.exp() / setup.Mc.neededForNextLevel()`>>
		<<if _leveled>>
			<<done>>
				<<replace ".reachedNewLvl">>You reached a new level - <<= setup.Mc.lvl()>> !
				<</replace>>
			<</done>>
			<<updatemeter 'xpBar' `setup.Mc.exp() / setup.Mc.neededForNextLevel()`>>
		<</if>>
	<</if>>
<</widget>>
