:: GeneralSection {"position":"2700,1800","size":"100,100"}
<<nobr>>
<div class="flexwrapper backgroundForText">
<<consumableCard "energyDrinkAmount" "ui/img/energy-drink.png" 15 "GeneralSection" 1 "You have {n} energy drinks">>
<<consumableCard "makeupAmount" "ui/img/cosmetics.png" 30 "GeneralSection" 10 "You have {n} makeup charges left">>
<<consumableCard "medicineAmount" "ui/img/medicine.png" 90 "GeneralSection" 1 "You have {n} pill(s) remaining">>
<div class="housecard">
<<image "ui/img/spray.png" "iconPx">><br>
<<if setup.Mall.needsPepperSpray()>>
<span class="priceAmount">30$</span><br>
<<if setup.Mc.money() gte 30>>
@@.buyItemLink;<<link "Buy" "GeneralSection">>
<<run setup.Mall.buyPepperSpray()>>
<</link>>@@<br>
<<else>><<thought>>I don't have enough money<</thought>>
<</if>>
<<else>><<thought>>I already have pepper spray (<<= setup.Mall.pepperSprayCharges()>> charges left)<</thought>>
<</if>>
</div>
</div>
<br>
@@.backbtn;[[Leave|Mall]] @@<br>
<</nobr>>
<<bodyBackground "assets/ui/img/general-section.jpg">>
