:: widgetHuntFooterLight [widget nobr] {"position":"3600,300","size":"100,100"}
/* huntFooterLight -- arg-less. Hunt counterpart of <<roomFooterLight>>:
   two image links that toggle the current room's light/dark state and
   re-render HuntRun so the body background re-resolves through
   setup.Styles.bgUrlForTemplate(template, dark). State lives on
   $run.lights keyed by floor-plan room id so each room remembers its
   setting independently; the cursedHuntLinkDisable wrapper gates
   clicks while a hunt is active, matching the haunted-house widget's
   behavior. */
<<widget "huntFooterLight">>
	<<set _roomId to setup.HuntController.currentRoomId()>>
	<<if _roomId>>
		<<capture _roomId>>
			<div class="hunt-run-lights">
			<span class="cursedHuntLinkDisable"><span class="kbnav-light-on"><<link "<<image \"ui/img/lighton.png\">>" "HuntRun">><<run setup.HuntController.setRoomLight(_roomId, setup.RoomLight.LIT)>>
			<</link>></span><span class="kbnav-light-off"><<link "<<image \"ui/img/lightoff.png\">>" "HuntRun">><<run setup.HuntController.setRoomLight(_roomId, setup.RoomLight.DARK)>>
			<</link>></span></span>
			</div>
		<</capture>>
	<</if>>
<</widget>>

:: widgetHuntToolBar [widget nobr] {"position":"3600,200","size":"100,100"}
/* huntToolBar -- arg-less. Renders one tool card per entry in
   setup.HuntController.startingTools(), which folds the run's loadout
   and the Empty Bag modifier into the canonical setup.searchToolOrder:
   default runs show all six (EMF, Ectoglass, GWB, Spiritbox,
   Thermometer, UVL); a loadout that names a subset shows just those;
   Empty Bag collapses the strip to a "no tools" placeholder.

   Per-slot markup lives in <<huntToolSlot>> below. setup.ensureHuntSearchBag
   (ToolController) seeds the per-tool counter object the meter reads
   from. */
<<widget "huntToolBar">>
	<<set _tools to setup.HuntController.startingTools()>>
	<<if _tools.length eq 0>>
		<div class="hunt-tool-card hunt-tool-card-empty">
			<<thought>>(your bag is empty)<</thought>>
		</div>
	<<else>>
		<<run setup.ensureHuntSearchBag()>>
		<<for _t range _tools>>
			<<set _def to setup.searchToolDefs[_t]>>
			<<capture _t, _def>>
				<div class="hunt-tool-card">
					<div class="hunt-tool-icon-wrap">
						<<image "ui/img/" + _def.iconFile { class: "hunt-tool-icon" }>>
						<div class="hunt-tool-countdown" @data-tool="_t"></div>
					</div>
					<<huntToolSlot _t>>
				</div>
			<</capture>>
		<</for>>
	<</if>>
<</widget>>

:: widgetHuntToolCountdownContent [widget nobr] {"position":"3600,250","size":"100,100"}
/* huntToolCountdownContent -- args[0] = equipment tier (total ticks),
   args[1] = remaining ticks until the result drops. Renders the pie
   fill (a conic-gradient circle that gains one slice per tick) behind
   the countdown number; <<huntToolSlot>>'s tick replace targets the
   wrapping .hunt-tool-countdown div, so each tick rebuilds both the
   pie and the number in one shot. */
<<widget "huntToolCountdownContent">><<silently>>
	<<set _eq to _args[0]>>
	<<set _rem to _args[1]>>
	<<set _pct to (_eq gt 0) ? (((_eq - _rem) / _eq) * 100) : 0>>
	/* Hue ramps from 0° (red) at 0% fill to 120° (green) at 100%, so
		the border + fill colour shifts as the pie completes. */
	<<set _hue to Math.round(_pct * 1.2)>>
	<<set _pieStyle to '--pie-pct: ' + _pct + '; --pie-color: hsl(' + _hue + ', 75%, 50%)'>>
<</silently>><div class="hunt-tool-pie" @style="_pieStyle"></div><span class="hunt-tool-countdown-num"><<= _rem>></span>
<</widget>>

/* huntToolSlot -- args[0] = tool key. Renders the link for one hunt
   tool slot. Click starts a <<repeat>>-driven meter that mirrors
   <<searchTool>>: each tick fires <<huntTickEventChain>> + <<toolTick>>,
   the meter completes after `$equipment.<tool>` ticks, and the renderer
   output is fed to the hidden #hunt-tool-sink so its side-effect macros
   (<<deferGoto>> for hits, evidenceFind stamping, tool activations)
   still fire while no top-of-screen tray is rendered. The visible
   completion signal lives entirely in the per-tool card overlay:
   <<huntCardMarkup>> drops a number / colored reading / thumbs-down
   into the countdown square via setup.ToolController.huntCardMarkup().

   Differences from the in-house <<searchTool>>:
     * Uses <<link>> (multi-use) so the player can re-fire the same
       tool without leaving HuntRun -- the in-house markup relies on
       the room re-rendering on nav, which doesn't happen here.
     * Adds a sanity/exhaustion guard after <<applyTickEffects>> so a
       stat-collapse landed by the click routes through huntOverPassage
       (which settles the run and goes to the HuntOver* narrative)
       immediately instead of waiting for the next nav.
     * Refreshes the .hunt-conditions HUD after the tick so per-step
       deltas + contributor chips track stat changes from the click.
   The shared bridges (setup.HuntController.activeGhost / setup.isGhostHere /
   setup.HuntController.huntOverPassage) make the per-tick chain
   reusable.

   Tools whose searchToolDefs entry sets needsLightCheck (currently
   spiritbox) are gated on the current room being dark -- mirroring
   the lights-off guard the in-house <<searchTool>> markup emits.
   When the room is lit the click drops the thumbs-down marker into
   the per-tool card (no meter starts), so the player still gets
   immediate visual feedback that the click was rejected; the
   predicate reads through setup.HuntController.isCurrentRoomDark so
   the catalogue flag drives the rule, no per-tool branch in the
   widget. */
<<widget "huntToolSlot">>
	<<set _t to _args[0]>>
	<<set _def to setup.searchToolDefs[_t]>>
	<<set _meterName to "searchHunt" + _def.meterField>>
	<<set _equipField to _def.equipField>>
	<<set _countdownSel to '.hunt-tool-countdown[data-tool="' + _t + '"]'>>
	<<capture _t, _def, _meterName, _equipField, _countdownSel>>
		<span class="hunt-tool-card-label cardlink" @data-tool="_t">@@.adaptiveLink;<<link `_def.label`>>
			<<run setup.ToolController.clearAllHuntCards()>>
			<<if _def.needsLightCheck and not setup.HuntController.isCurrentRoomDark()>>
				<<run setup.ToolController.setHuntCardMarkup(setup.ToolController.huntCardThumbsDownMarkup())>>
				<<run $(_countdownSel).empty().wiki(setup.ToolController.huntCardMarkup())>>
			<<else>>
				<<addclass ".cardlink" "disabled-link">>
				<<replace `_countdownSel`>><<huntToolCountdownContent `$equipment[_equipField]` `$equipment[_equipField] - $currentsearchHunt[_t]`>><</replace>>
				<<repeat `$timerToolsDecreased`>>
					<<if $currentsearchHunt[_t] neq $equipment[_equipField]>>
						<<huntTickEventChain>>
					<</if>>
					<<if $currentsearchHunt[_t] lte ($equipment[_equipField] - 1)>>
						<<toolTick>>
						<<set $currentsearchHunt[_t] += 1>>
						<<replace `_countdownSel`>><<huntToolCountdownContent `$equipment[_equipField]` `$equipment[_equipField] - $currentsearchHunt[_t]`>><</replace>>
					<<elseif $currentsearchHunt[_t] gte $equipment[_equipField]>>
						<<replace "#hunt-tool-sink">>
							<<if _t eq "temperature">>
								<<include "TemperatureHigh">>
							<<else>>
								<<toolCheck _t>>
							<</if>>
						<</replace>>
						<<run $(_countdownSel).empty().wiki(setup.ToolController.huntCardMarkup())>>
						<<run $("#hunt-tool-inline").empty().wiki(setup.ToolController.huntInlineMarkup())>>
						<<applyTickEffects>>
						<<refreshHuntHud>>
						<<set $currentsearchHunt[_t] to 0>>
						<<removeclass ".cardlink" "disabled-link">>
						<<if setup.Mc.isSanityCollapsed() or setup.Mc.sanity() lte 0>>
							<<goto setup.HuntController.huntOverPassage("sanity")>>
						<<elseif setup.Mc.isExhausted()>>
							<<goto setup.HuntController.huntOverPassage("exhaustion")>>
						<<else>>
							<<stop>>
						<</if>>
					<</if>>
				<</repeat>>
			<</if>>
		<</link>>@@</span>
	<</capture>>
<</widget>>
