:: HuntStart [nobr] {"position":"3000,200","size":"100,100"}
/* Entry point for a hunt. The lobby lives here -- the actual gameplay
   lives in HuntRun.

   Two arrival paths:

     1. Fresh launch -- no run is active. HuntStart rolls modifiers
        + floor plan from $nextHuntSeed and stamps the run via
        setup.HuntController.startHunt. Static-plan houses
        (setup.HuntHouses) pass their catalogue id through
        $pendingHuntHouseId, which the GhostStreet card sets and
        HuntStart consumes once.

     2. Resume -- a run is already active. The player got here via
        save/reload, browser back-button, or a sidebar nav while a
        run was in flight. HuntStart re-renders the lobby for the
        existing run without rolling fresh modifiers or a new seed.
        The address / modifier list / objective stay pinned to the
        run's original seed, so reloading the same save shows the
        same address.

   The "no resume" forfeit (clicking a GhostStreet card while a run
   is in flight) lives on the card widgets themselves -- they call
   setup.HuntController.endHunt(false) before navigating here, so
   the click ends the old run and HuntStart sees a clean slate.
   Putting the forfeit on the card click keeps save/reload paths
   from accidentally tripping it (rollNextSeed) and rotating the
   seed. */
<<if not setup.HuntController.isActive()>>
	<<set _huntSeed to setup.HuntController.nextSeed()>>
	<<set _huntStaticHouseId to $pendingHuntHouseId or null>>
	<<set $pendingHuntHouseId to null>>
	<<run setup.HuntController.startHunt({ seed: _huntSeed, staticHouseId: _huntStaticHouseId })>>
<</if>>
<<set _run to setup.HuntController.active()>>
<<set _modifiers to setup.Modifiers.activeList()>>
<<set _staticHouseId to setup.HuntController.staticHouseId()>>
<<set _staticHouse to _staticHouseId ? setup.HuntHouses.byId(_staticHouseId) : null>>
<<set _huntHouseImage to (_staticHouse and _staticHouse.image) or 'ui/img/hunt-house.jpg'>>

<<bodyBackground `'assets/' + _huntHouseImage`>>

<div class="hunt-lobby">
	<div class="hunt-lobby-panel">
		<div class="hunt-lobby-header">
			<div class="hunt-lobby-address">@@.location;<<= setup.HuntController.address().formatted>>@@</div>
			<<if _staticHouse and _staticHouse.description>>
				<div class="hunt-lobby-flavor">@@.mc-thoughts;<<= _staticHouse.description>>@@</div>
			<<else>>
				<div class="hunt-lobby-flavor">@@.mc-thoughts;You stand on the porch a beat longer than you need to. Key in your pocket, still cold. That part won't last.@@</div>
			<</if>>
		</div>

		<<if _modifiers.length>>
			<div class="hunt-lobby-section">
				<div class="hunt-lobby-section-title">@@.location;Modifiers@@</div>
				<div id="hunt-lobby-modifiers" class="hunt-lobby-modifiers">
					<<for _m range _modifiers>>
						· <span class="usebtn" @title="_m.description"><<= _m.name>></span> -- <<= _m.description>><br>
					<</for>>
				</div>
				<span id="hunt-lobby-reroll" class="hunt-lobby-reroll"><<huntLobbyRerollControl>></span>
			</div>
		<</if>>

		<div class="hunt-lobby-section">
			<div class="hunt-lobby-section-title">@@.location;Objective@@</div>
			<div class="hunt-lobby-objective">@@.mc-thoughts;<<= (_staticHouse and _staticHouse.objectiveDescription) || setup.HuntController.objectiveDescription(_run.objective) || _run.objective>>@@</div>
		</div>

		<<if setup.HuntController.huntAllowsCompanions() and setup.Companion and setup.Companion.hasActiveCompanion()>>
			<<set _ac to setup.Companion.active()>>
			<<if _ac>>
				<<run setup.Companion.autoAttachOnHuntStart()>>
				<div class="hunt-lobby-section hunt-lobby-companion-row">
					@@.mc-thoughts;<<= _ac.name>> is waiting for you out front.@@<br>
					@@.usebtn;
						<<link `"Talk to " + _ac.pronObj` "CompanionMain">>
						<</link>>
					@@
				</div>
			<</if>>
		<</if>>

		<div class="hunt-lobby-actions">
			@@.movebtn;[[Enter the hunt|HuntRun]]@@
			@@.backbtn;[[Cancel|CityMap][setup.HuntController.end()]]@@
		</div>
	</div>
</div>

:: HuntRun [nobr] {"position":"3100,200","size":"100,100"}
/* Placeholder hunt gameplay laid out to mirror the regular ghost
   hunts: minimap top-left, modifiers top-right, furniture-icon
   strip + HUD + tools/nav row at the bottom. The "tools" panel is
   a dashed placeholder until hunt tool gameplay lands. Furniture
   icons reuse the scenes/furniture/<suffix>.png set the authored
   haunts use, so e.g. a procedural kitchen still shows
   desk/table/sink1 thumbnails. */
<<if not setup.HuntController.isActive()>>
	@@.mc-thoughts; No active hunt.@@<br>
	@@.backbtn; [[Back|CityMap]]@@
<<else>>
	<<set _run to setup.HuntController.active()>>
	<<set _modifiers to setup.Modifiers.activeList()>>
	<<set _cr to setup.HuntController.currentRoomData()>>

	<<if _cr>>
		<<bodyBackground `setup.Styles.bgUrlForTemplate(_cr.template, setup.HuntController.isRoomDark(_cr.id), setup.HuntController.staticHouseId())`>>
	<</if>>

	<div class="hunt-run-layout">
		<div id="hunt-tool-sink" class="hunt-tool-sink"></div>
		<div class="hunt-run-top">
			<div class="hunt-run-tl">
				<<huntMinimap>>
			</div>
			<div class="hunt-run-tr">
				@@.location; Objective@@<br>
				<span class="hunt-run-objective"><<= _run.objective>></span><br>
				@@.location; <<= setup.HuntController.address().formatted>>@@<br>
				<<if _modifiers.length>>
					<br>
					@@.location; Active modifiers@@<br>
					<<for _m range _modifiers>>
						<span class="usebtn hunt-modifier-chip" @title="_m.description"><<= _m.name>></span><br>
					<</for>>
				<</if>>
			</div>
		</div>

		<<set _detectorOn to setup.ToolController.detectorBought()>>
		<div class="hunt-run-bottom">
			<div id="hunt-tool-inline" class="hunt-tool-inline"></div>
			<div class="hunt-run-furniture">
				<<if _cr and _cr.furniture.length>>
					<<for _f range _cr.furniture>>
						<<capture _f>>
							<span @class="'hunt-furniture-item' + (_detectorOn and _f.lootKinds.length ? ' highlighted-furnitureDetector' : '')">
								<<link `'<<image "scenes/furniture/' + _f.suffix + '.png">>'` "FurnitureSearch">>
									<<run setup.HuntController.setSearchedFurniture(_f.suffix)>>
									<<addTime 1>>
								<</link>>
								<span class="hunt-furniture-label"><<= _f.label>></span>
							</span>
						<</capture>>
					<</for>>
				<<elseif _cr>>
					@@.mc-thoughts; (bare room)@@
				<<else>>
					/% _cr is null only when currentRoomId points to a non-existent room (corrupted save). Render nothing; the outer isActive gate is the player-visible recovery path for a missing $run. %/
				<</if>>
			</div>
			<div class="hunt-conditions"><<huntConditions>></div>
			<div class="hunt-run-hud">
				<div class="hunt-run-effects"><<huntEffectsList>></div>
				<<huntFooterLight>>
			</div>
			<div class="hunt-run-toolbar">
				<div class="hunt-run-tools">
					<<huntToolBar>>
				</div>
				<div class="hunt-run-actions"><<huntActionBar>></div>
				<div class="hunt-run-companion">
					<<companionCard>>
				</div>
				<div class="hunt-run-nav">
					<<if _cr and _cr.neighbors.length>>
						<<for _n range _cr.neighbors>>
							<<capture _n>>
								@@.movebtn;<<link _n.label "HuntRun">>
									<<run setup.HuntController.setCurrentRoom(_n.id)>>
									<<huntTickStep>>
								<</link>>@@<br>
							<</capture>>
						<</for>>
					<<else>>
						@@.mc-thoughts; (no exits)@@<br>
					<</if>>
					<<if _cr and _cr.template eq setup.FloorPlan.HALLWAY_TEMPLATE>>
						@@.movebtn; [[Outside|HuntOutside]]@@<br>
					<</if>>
				</div>
			</div>
		</div>
	</div>
<</if>>

:: HuntOutside [nobr] {"position":"3100,300","size":"100,100"}
/* The yard outside the haunt. Reached from HuntRun's hallway via the
   Outside nav link; only the hallway exposes that link. The run is
   still active here -- the player can pick the ghost (HuntIdentify
   for a rogue hunt, or carry the findings back to Khadija for a
   contract hunt), forfeit the run on the spot, or step back into the
   hallway and keep exploring. The hunt event chain is paused while
   the player is on this passage (HuntController.isHuntActive()
   answers off HuntRun only), matching the in-house ticks pausing
   when the player leaves the house.

   The identify path forks on whether the run is a contract hunt.
   Khadija's deal -- "I sell keys, not jobs. You come back and tell me
   what was in there." -- means contract hunts settle at the witch's
   desk, not at the front yard. Rogue hunts (no key in hand for this
   house) still resolve on the spot through HuntIdentify.

   Exhibitionism gate: if the ghost stripped the MC and she's still
   exposed (bottomless and/or top-bare with a stolen piece available
   to recover), a low-exhibitionism MC (< 5, the same threshold
   HuntOverExhaustion / CompanionMain / FindStolenClothes / NudityEvent
   use) refuses to walk out of the yard. The identify / contract /
   flee options are hidden and only "Go back inside" remains -- she
   has to retrace her steps and find her clothes before settling the
   run. */
<<if not setup.HuntController.isActive()>>
	@@.mc-thoughts; No active hunt.@@<br>
	@@.backbtn; [[Back|CityMap]]@@
<<else>>
	<<set _heldId to setup.WitchContract.heldHouseId()>>
	<<set _staticId to setup.HuntController.staticHouseId()>>
	<<set _isContractHunt to _staticId and _heldId eq _staticId>>
	<<set _bottomless to setup.HauntedHouses.isBottomless()>>
	<<set _topBare to setup.HauntedHouses.isTopBare()>>
	<<set _modest to (setup.Mc.exhibitionism() || 0) lt 5>>
	<<set _canCoverBottom to _bottomless and (setup.Wardrobe.isPantiesStolen() or setup.Wardrobe.isBottomStolen())>>
	<<set _canCoverTop to _topBare and (setup.Wardrobe.isShirtStolen() or setup.Wardrobe.isBraStolen())>>
	<<set _forceCover to _modest and (_canCoverBottom or _canCoverTop)>>
	@@.location; Outside the haunt@@<br>
	<<if _forceCover>>
		@@.mc-thoughts;
		<<if _canCoverBottom and _canCoverTop>>
			The yard is cold. The wind finds every inch of you the ghost left bare. No -- you're not walking off down a public street like this. Go back in. Find your clothes.
		<<elseif _canCoverBottom>>
			The yard is cold and there's nothing on your lower half. You're not stepping past the gate bottomless. Back inside. Find what it took.
		<<else>>
			The yard is cold. Your arms cross over your chest on their own. You're not walking out half-undressed where anyone could see. Back inside. Find what it took.
		<</if>>
		@@<br>
		<br>
		@@.movebtn; [[Go back inside|HuntRun]]@@
	<<else>>
		@@.mc-thoughts; The yard is cold. The house knows you're still here. Name what's in there, walk, or go back in.@@<br>
		<br>
		<<if _isContractHunt>>
			@@.movebtn; [[Take your findings to Khadija|WitchInside]]@@<br>
		<<else>>
			@@.movebtn; [[Identify the ghost|HuntIdentify]]@@<br>
		<</if>>
		@@.movebtn;<<link "Flee the hunt">>
			<<run setup.HuntController.markFailure(setup.HuntController.FailureReason.FLED)>>
			<<set _flee to setup.HuntController.endHunt(false)>>
			<<set _fleeDest to _flee ? _flee.exitPassage : "CityMap">>
			<<goto _fleeDest>>
		<</link>>@@<br>
		@@.movebtn; [[Go back inside|HuntRun]]@@
	<</if>>
<</if>>

:: HuntIdentify [nobr] {"position":"3200,300","size":"100,100"}
/* Pick a ghost from the catalogue dropdown and lock it in. The guess
   is compared against setup.HuntController.ghostName() (the per-run
   ghost rolled at startHunt). The reveal lives in HuntIdentifyResolve
   so the prep beat + timed pause + correct/wrong branch all render in
   one place. */
<<if not setup.HuntController.isActive()>>
	@@.mc-thoughts; No active hunt.@@<br>
	@@.backbtn; [[Back|CityMap]]@@
<<else>>
	@@.location; Name the ghost@@<br>
	@@.mc-speech; Calling it. It was --@@<br>
	<<ghostTypeDropdown>><br>
	@@.movebtn; [[Choose|HuntIdentifyResolve]]@@<br>
	<br>
	@@.backbtn; [[Back|HuntOutside]]@@
<</if>>

:: HuntIdentifyResolve [nobr] {"position":"3300,300","size":"100,100"}
/* Resolves an identify attempt. The MC re-enters the haunt to subdue
   the ghost; after a short pause the run either closes peacefully
   (correct guess -- markSuccess + endHunt + goto exitPassage) or the
   ghost catches the MC (wrong guess -- routes to HuntOverProwl, whose
   huntBlackoutExit widget stamps a CAUGHT failure).

   Reveal staging: the result line and exit links are wrapped in
   .hunt-reveal (opacity:0, 1s opacity transition). The reveal text
   gets .show on render so it fades in immediately; the buttons get
   .show after a 1s <<timed>> nested inside the 6s outer wait, so
   they fade in only once the text has fully settled. */
<<if not setup.HuntController.isActive()>>
	@@.mc-thoughts; No active hunt.@@<br>
	@@.backbtn; [[Back|CityMap]]@@
<<else>>
	@@.mc-thoughts; You set your jaw and walk back in. Subdue the ghost. Close the house. That's the order.@@<br>
	<<timed 6s>>
		<<if setup.HuntController.ghostName() eq setup.Ghosts.ghostTypeSelected()>>
			<<run setup.HuntController.markSuccess()>>
			<<set _winSummary to setup.HuntController.endHunt(true)>>
			<<set _winDest to _winSummary ? _winSummary.exitPassage : "CityMap">>
			<div class="hunt-reveal hunt-reveal-text">@@.notmc-speech; The shape thins out and goes. The house cools behind it.@@</div>
			<div class="hunt-reveal hunt-reveal-buttons">
				@@.movebtn;<<link "Go home" _winDest>>
				<</link>>@@
			</div>
		<<else>>
			<<set _trueGhost to setup.HuntController.activeGhost()>>
			<div class="hunt-reveal hunt-reveal-text">@@.mc-thoughts; Wrong call. It's a <<= _trueGhost.name>>, and every sign you know you should have recognized -- <<= _trueGhost.evidenceLabels()>> -- snaps back into place at once. You begin to bolt, but it's on you before you reach the door.@@</div>
			<div class="hunt-reveal hunt-reveal-buttons">
				@@.movebtn; [[Continue|HuntOverProwl]]@@
			</div>
		<</if>>
		<<done>>
			<<run $(".hunt-reveal-text").addClass("show")>>
		<</done>>
		<<timed 1s>>
			<<run $(".hunt-reveal-buttons").addClass("show")>>
		<</timed>>
	<</timed>>
<</if>>
