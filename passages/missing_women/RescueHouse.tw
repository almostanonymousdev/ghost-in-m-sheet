:: RescueHouse [nobr] {"position":"2175,1700","size":"100,100"}
<div style="position: relative;">

<<image setup.MissingWomen.rescueHouseImage(setup.MissingWomen.randomRescuePhotoNumber()) { class: setup.MissingWomen.tornStyleRandom() + ' hideRescueHouse', id: "rescueHouseHidden", width: "100%", style: "position: absolute; z-index: 10;" }>>

<<image setup.MissingWomen.rescueHouseImage(setup.MissingWomen.rescueHouse()) { width: "100%" }>>
</div>

<<if setup.MissingWomen.hasRescueClue()>>
	<<linkreplace "@@.usebtn;Compare the house with the photo@@">>
		<<removeclass "#rescueHouseHidden" "hideRescueHouse">>
		<<if setup.MissingWomen.isCorrectHouse()>>
			<<mc>>It seems like this is the house.<</mc>>
		<<else>>
			<<mc>>No, doesn't really look like it.<</mc>>
		<</if>>
	<</linkreplace>><br>
<</if>>
<<addTime 20>>
<<if setup.MissingWomen.searchTooLate()>>
	<<mc>>The nun said that after 18:00 it's pointless to keep searching. It seems I'm too late. I should go back to her and tell her I failed.<</mc>><br>
<<else>>
	<<if setup.MissingWomen.canSearchHouse()>>
		<<linkreplace '@@.usebtn; Search the house @@ <<statIcon setup.StatIcon.ENERGY>>'>>
			<<run setup.Mc.addEnergy(-1)>>
			<<if not setup.MissingWomen.isCorrectHouse()>>
				<<thought>>You search the house for 30 minutes, but find no one.<</thought>>
				<<addTime 30>>
			<<elseif setup.MissingWomen.canResolveRescue()>>
				<<goto "RescueEvent">>
			<<elseif setup.MissingWomen.questFailed()>>
				<<mc>>The nun said that after 18:00 it's pointless to keep searching. It seems I'm too late. I should go back to her and tell her I failed.<</mc>><br>
			<<else>>
				<<thought>>You search around but can't find anything yet. Maybe you should come back later.<</thought>>
			<</if>>
		<</linkreplace>>
	<<else>>
		<<mc>>I'm too tired to search the house.<</mc>><br>
	<</if>>
<</if>><br>
<br>
@@.backbtn;[[Back|RescueMap]]@@<br>
