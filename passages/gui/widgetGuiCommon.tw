:: widgetGuiCommon [widget nobr] {"position":"0,1900","size":"100,100"}
<<script>>
/* Thin <<addTime>> shim. Real logic lives in setup.Time; this stays
   only because the widget passes the Twee numeric arg straight through. */
setup.addTime = function (mins) { return setup.Time.addMinutes(mins); };

/* Stat icon ids. Values double as the asset slug under ui/img/<id>.png,
   so the <<statIcon>> widget can resolve the image with no extra map. */
setup.StatIcon = Object.freeze({
    BEAUTY:     "beauty",
    CORRUPTION: "corruption",
    EMF:        "emf",
    ENERGY:     "energy",
    HEALTH:     "hearth",
    SANITY:     "sanity",
    UVL:        "uvl"
});

/* Single source of truth for stat-delta widgets (<<addLust>>,
   <<addSanity>>, <<addEnergy>>, <<addFit>>). Each row pairs a stat
   name with the controller mutator, the HUD meter id, and a
   fill-ratio thunk. Optional hooks: outcomeGoto(outcome) returns a
   passage name to <<goto>> (sanity-collapse → hunt-over), and
   outcomeMessages(outcome) returns a list of {style, icon?, text}
   rows that <<addStat>> renders inline (fitness prose). The generic
   <<addStat>> widget reads from this table, the named widgets are
   one-line forwarders, and adding a new stat widget is a row +
   a forwarder. */
setup.STAT_CONFIG = {
    lust: {
        meter: 'mclust',
        pct:   function () { return setup.Mc.lustPct(); },
        apply: function (d) { return setup.Mc.addLust(d); }
    },
    sanity: {
        meter: 'sanity',
        pct:   function () { return setup.Mc.sanityPct(); },
        apply: function (d) { return setup.Mc.addSanity(d); },
        outcomeGoto: function (outcome) {
            if (outcome === setup.SanityDeltaResult.COLLAPSED && setup.HuntController.isActive()) {
                return setup.HuntController.huntOverPassage('sanity');
            }
            return null;
        }
    },
    energy: {
        meter: 'energy',
        pct:   function () { return setup.Mc.energyPct(); },
        apply: function (d) { return setup.Mc.addEnergy(d); }
    },
    fit: {
        meter: 'energy',
        pct:   function () { return setup.Mc.energyPct(); },
        apply: function (d) { return setup.Mc.addFit(d); },
        /* Returns an array of {style, icon?, text} message rows. The
           addStat widget renders each: with an icon, prepends "Your"
           plus the icon; otherwise just the text. Macro markup is
           kept out of JS strings because the IDE linter parses .tw
           files literally and chokes on macro tokens inside strings. */
        outcomeMessages: function (o) {
            var I = setup.StatIcon;
            var msgs = [];
            if (o.beautyIncrease > 0) {
                msgs.push({ style: 'mc-speech', icon: I.BEAUTY, text: 'has improved (+1): ' + o.beauty + ' now!' });
            }
            if (o.energyMaxDelta > 0 && !o.hitEnergyCap) {
                msgs.push({ style: 'mc-speech', icon: I.ENERGY, text: 'has increased (+' + o.energyMaxDelta + '): ' + o.energyMax + ' now!' });
            }
            if (o.hitEnergyCap) {
                msgs.push({ style: 'mc-speech', icon: I.ENERGY, text: 'has reached the maximum of 20!' });
            }
            if (o.reachedFitCap) {
                msgs.push({ style: 'mc-thoughts', text: 'Your fitness level is perfect - 100' });
            } else {
                msgs.push({ style: 'mc-thoughts', text: 'Your fitness level has improved (+1): ' + o.fit + ' now!' });
            }
            return msgs;
        }
    }
};
<</script>>

<<widget "statIcon">>
	<<set _statIconId to _args[0]>>
	<<set _statIconGray to _args[1] is true ? "filter: grayscale(1); " : "">>
	<<image "ui/img/" + _statIconId + ".png" { style: "position: relative; top: 0.375em; " + _statIconGray + "width:3%; display: inline; margin: 0;" }>>
<</widget>>

<<widget "backOrReturn">>
	<<if setup.Gui.useBackInsteadOfReturn()>>
		@@.backbtn;<<back>>@@<br>
	<<else>>
		@@.backbtn;<<return>>@@<br>
	<</if>>
<</widget>>

<<widget "addTime">>
	<<if not setup.Flashbacks.isReplaying()>>
		<<set _mins to _args[0]>>
		<<set _crossedMidnight to setup.addTime(_mins)>>
		<<if _crossedMidnight>><<run setup.Tick.resetCooldowns()>><</if>>
		<<done>>
			<<replace "#time">><<= setup.Time.display()>><</replace>>
		<</done>>
	<</if>>
<</widget>>

<<widget "addStat">>
	<<if not setup.Flashbacks.isReplaying()>>
		<<set _statCfg to setup.STAT_CONFIG[_args[0]]>>
		<<set _statOutcome to _statCfg.apply(_args[1])>>
		<<refreshMeter _args[0]>>
		<<if _statCfg.outcomeGoto>>
			<<set _statTarget to _statCfg.outcomeGoto(_statOutcome)>>
			<<if _statTarget>><<goto _statTarget>><</if>>
		<</if>>
		<<if _statCfg.outcomeMessages>>
			<<for _statMsg range _statCfg.outcomeMessages(_statOutcome)>>
				<<if _statMsg.icon>>
					<span @class="_statMsg.style"><span class="evidenceText">Your <<statIcon _statMsg.icon>> <<= _statMsg.text>></span></span><br>
				<<else>>
					<span @class="_statMsg.style"><span class="evidenceText"><<= _statMsg.text>></span></span><br>
				<</if>>
			<</for>>
		<</if>>
	<</if>>
<</widget>>

<<widget "addLust">><<addStat 'lust' _args[0]>><</widget>>

<<widget "addSanity">><<addStat 'sanity' _args[0]>><</widget>>

<<widget "addEnergy">><<addStat 'energy' _args[0]>><</widget>>

<<widget "addLustByPart">>
	<<if not setup.Flashbacks.isReplaying()>>
		<<set _lustBase to _args[0] !== undefined ? _args[0] : 2>>
		<<run setup.Mc.addLustByPart(setup.Events.currentArgForRandomizer(), _lustBase)>>
		<<refreshMeter 'lust'>>
	<</if>>
<</widget>>

/* refreshMeter -- repaint one or more sidebar HUD meters from the current
   setup.Mc.<stat>Pct() value. Use after a direct setup.Mc.setLust(0) /
   removeSanity / etc. mutation that bypasses the <<addStat>> wrappers, so
   the sidebar bar animates to the new value without waiting for the next
   passage transition. Accepts any number of stat keys ('lust', 'sanity',
   'energy'); a no-arg call is a no-op. */
<<widget "refreshMeter">>
	<<for _refreshStat range _args>>
		<<set _refreshCfg to setup.STAT_CONFIG[_refreshStat]>>
		<<updatemeter _refreshCfg.meter _refreshCfg.pct()>>
	<</for>>
<</widget>>

<<widget "addFit">><<addStat 'fit' _args[0]>><</widget>>
