:: Livingroom [nobr] {"position":"700,800","size":"100,100"}
<<image "ui/img/mclivingroom.jpg" { width: "100%" }>><br>
@@.location; Livingroom@@<br>
<br>
<<if setup.Home.tentaclesPCText() eq 1>>
	<<mc>>These are the creatures from nightmares... they've appeared here too<</mc>><br>
	<<run setup.Home.clearTentaclesPCText()>>
<<elseif setup.Home.tentaclesPCText() eq 2>>
	<<mc>>They're not so bad after all.<</mc>><br>
	<<run setup.Home.clearTentaclesPCText()>>
<<elseif setup.Home.tentaclesPCText() eq 3>>
	<<mc>>It's a shame they disappeared... I hope next time I'll be able to keep them.<</mc>><br>
	<<run setup.Home.clearTentaclesPCText()>>
<<elseif setup.Home.tentaclesTVText() eq 1>>
	<<mc>>How long did I sleep? Doesn't matter, I feel fantastic!<</mc>> <<vocal mc>>Hehe<</vocal>><br>
	<<run setup.Home.clearTentaclesTVText()>>
<</if>>
<<if previous() is "Home" and setup.Witch.hasCursedItemToTurnIn()>>
	As you walk into the house, it creaks and groans as if it's trying to warn you of something. Almost simultaneously, a splinter in the doorway snags your bag, stopping you in your tracks.<br>
	<br>
<</if>>
@@.usebtn;<<link "Watch tv (30 min)" "Livingroom">>
	/* Decide the destination on the pre-action clock, THEN burn the 30m.
		<<addTime>> can cross midnight (resetting daily cooldowns) or push
		a time-gated event out of its window, so checking readiness after
		the advance silently drops an event that was ready at click-time. */
	<<set _tvEvent to "">>
	<<if setup.CursedItems.isItemCursed("tv")>>
		<<set _tvEvent to "CursedTVEvent">>
	<<elseif setup.SpecialEvent.spiritEventReady()>>
		<<set _tvEvent to "GhostSpecialEventTVSpirit">>
	<<elseif setup.Home.succubusTVEventReady()>>
		<<set _tvEvent to "SuccubusEventTV">>
	<<elseif setup.Home.tentaclesTVEventReady()>>
		<<set _tvEvent to "TentaclesEventTV">>
	<</if>>
	<<addTime 30>>
	<<if _tvEvent isnot "">><<goto _tvEvent>><</if>>
<</link>>@@<br>
<<if setup.CursedItems.isItemCursed("pc")>>
	@@.enterbtn;<<link "Use PC" "CursedPCEvent">>
	<</link>>@@<br>
<<else>>
	@@.enterbtn;[[Use PC]]@@<br>
<</if>>
@@.enterbtn;<<link "Bedroom" "Bedroom">><<addTime 0.5>>
<</link>>@@<br>
<<if setup.Time.hours() <= 22 and setup.Time.hours() >= 12>>
	@@.usebtn;<<link "Skip time till midnight" "Livingroom">><<run setup.Home.skipTimeToMidnight()>>@@
		<<replace "#time">><<= setup.Time.display()>><</replace>>
	<</link>><br>
<</if>>

<<if setup.Home.succubusCanKnock()>>
	<<linkreplace "@@.usebtn; Someone is gently knocking on the door@@">>
		<<run setup.Home.markSuccubusArrived()>>
		<<thought>>You open the door -- no one is there. A light breeze brushes against your face and fades away.<</thought>><br>
		<<mc>>Hmm... Strange, I could've sworn I heard knocking...<</mc>>
	<</linkreplace>><br>
<</if>>

<<if setup.Home.isNightForHunt()>>
	<<if not setup.Wardrobe.isDressedForStreet()>>
		<<thought>>I can't go outside naked<</thought>>
	<<elseif setup.Home.isDirty()>>
		<<thought>>I need to go to the bathroom first<</thought>>
	<<elseif setup.Home.isCorruptEnoughToSkipUnderwear()>>@@.movebtn;[[Ghost hunting|GhostStreet]]@@
	<<elseif not setup.Wardrobe.isWearingUnderwear()>><<thought>>I can't go outside without underwear<</thought>>
	<<else>>@@.movebtn;[[Ghost hunting|GhostStreet]]@@
	<</if>>
<<else>> <<thought>>Not appropriate time for ghost hunting<</thought>>
<</if>>
<br>
<br>
<<if not setup.Wardrobe.isDressedForStreet()>>
	<<thought>>I can't go outside naked<</thought>>

<<elseif setup.Home.isDirty()>><<thought>>I need to go to the bathroom first<</thought>>
<<elseif setup.Home.isCorruptEnoughToSkipUnderwear()>>@@.backbtn;[[Leave|Home]]@@
<<elseif not setup.Wardrobe.isWearingUnderwear()>>
	<<thought>>I can't go outside without underwear<</thought>>
<<else>>@@.backbtn;[[Leave|Home]]@@
<</if>>
/*[[RoomCleanup]]*/
<<if previous() is "GhostSpecialEventWraithStart">>
	<<addTime 60>>
<</if>>
