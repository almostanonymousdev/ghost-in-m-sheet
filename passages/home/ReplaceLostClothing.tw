:: ReplaceLostClothing [nobr] {"position":"600,1000","size":"100,100"}
@@.location; Replace lost clothing@@<br>
<br>
<<if not setup.Wardrobe.hasLostClothing()>>
	<<thought>>Nothing to replace -- my wardrobe is back in order.<</thought>><br>
<<else>>
	<<thought>>The ghost made off with these. I can pop down to the mall later, or just order replacements now.<</thought>><br>
	<br>
	<div class="flexwrapper backgroundForText">
	<<for _id range setup.Wardrobe.lostClothing()>>
		<<set _item to setup.Wardrobe.itemById(_id)>>
		<<if _item and _item.price>>
			<div class="housecard">
			<<image "outfits/wardrobe/" + _item.img "iconPx">><br>
			<span class="priceAmount"><<= _item.price>>$</span><br>
			<<if setup.Mc.money() gte _item.price>>
				<<capture _id>>
					@@.buyItemLink;<<link "Replace" "ReplaceLostClothing">>
						<<run setup.Wardrobe.replaceLostClothing(_id)>>
					<</link>>@@<br>
				<</capture>>
			<<else>>
				<<thought>>I don't have enough money<</thought>>
			<</if>>
			</div>
		<</if>>
	<</for>>
	</div>
	<br>
<</if>>
@@.backbtn;[[Back|Bedroom]]@@
