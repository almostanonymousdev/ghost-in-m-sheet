		<<say>>Oh, you are so tight. Do you like the way I fuck you?<</say>><br>
		@@.mc-speech; Mm~ No...~m~No@@<br>
		<<say>>Well then [[I'll continue|DeliveryEvent2]]<</say>>
	<</linkappend>>@@
<<case "package">>
	<<addLust 45>>
	<<deliveryLustOverflow>>
	<<deliveryVideo "packageevent" 3 4>>
	<<say>>Do you like it, slut?<</say>><br>
	@@.mc-speech; Oh~Please don't stop~Your cock is so good~@@<br>
	<<linkreplace "@@.mc-speechLink;Continue@@">>
		<<addLust 45>>
		<<deliveryLustOverflow>>
		<<deliveryVideo "packageevent" 6>>
		<<vocal mc>>Oh<</vocal>> <<mc>>It feels amazing<</mc>><br>
		@@.mc-speechLink; [[He's cumming|DeliveryEvent2]]@@
	<</linkreplace>>
<<case "papers">>
	/* Papers' Event1 is terminal: marks the cooldown, awards the
