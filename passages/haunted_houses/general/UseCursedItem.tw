:: UseCursedItem [nobr] {"position":"2200,1250","size":"100,100"}
/* Video lookup reads the carried type *before* we consume it, then
   the run below clears the type flag + held marker so the player isn't
   stuck holding a phantom item (which would otherwise block Brook from
   fetching another and leave the witch unable to take a turn-in). */
<<set _vid to setup.Witch.cursedItemVideo()>>
<<run setup.Witch.consumeCarriedCursedItem()>>
<br>
<<if _vid>>
	<<video _vid "displayCentredImgs">><br>
	<<vocal mc>>Ah<</vocal>> <<mc>>I can't... and don't want to... stop<</mc>><br>
	<<thought>>You play with yourself until you cum<</thought>><br><<mc>>Ohh, I feel wonderful.<</mc>><br>
	<<if not setup.Flashbacks.isReplaying()>>
		<<run setup.Mc.setLust(0)>>
		<<refreshMeter 'lust'>>
	<</if>>

<</if>>
<<addclass "body" "style-video-height">>
<br>
<<if setup.Flashbacks.isReplaying()>>
	/* During gallery replay `previous()` resolves to FlashbackEnter,
		which immediately <<goto>>s back to UseCursedItem and traps the
		player. Route Back through Flashbacks instead -- containReplay
		sees the gallery target and runs exitReplay() cleanly. */
	@@.backbtn; [[Back|Flashbacks]]@@
<<else>>
	@@.backbtn; [[Back|previous()]]@@
<</if>>
<<done>>
	<<addclass ".linkselector" "disabled-link">>
<</done>>
