:: widgetTarot [widget nobr] {"position":"800,3300","size":"100,100"}
/* Per-card effect widgets invoked from TarotCards.tw via the data-driven
   dispatcher. Each widget owns the post-draw behaviour for one card
   (video clip, stat deltas, goto) so the draw passage holds only the
   reveal animation + dispatch -- not a 10-arm if/elseif chain. */

<<widget "tarotPassion">>
	<<timed 2s>>
		<<randRangeVideo "mechanics/cursedpossessions/passion" 1 4 ".mp4">>
		<<vocal mc>>Ah<</vocal>> <<mc>>I'm getting so wet down there... mmm.<</mc>><br>
		<<thought>>Lust increased: +15 <<statIcon setup.StatIcon.HEALTH>><</thought>><br>
		<<thought>>Sanity decreased: -15 <<statIcon setup.StatIcon.SANITY>><</thought>><br>
		<<addSanity -15>>
		<<addLust 15>>
		<<run setTimeout(() => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }), 50)>>
	<</timed>>
<</widget>>

<<widget "tarotPulse">>
	<<timed 2s>>
		<<randRangeVideo "mechanics/cursedpossessions/pulse" 1 4 ".mp4">>
		<<mc>>My... oh—my little asshole is pulsating so hard...<</mc>><br>
		<<mc>>Somehow, I feel much better after that...<</mc>><br>
		<<thought>>Lust decreased: -15 <<statIcon setup.StatIcon.HEALTH>><</thought>><br>
		<<thought>>Sanity increased: +15 <<statIcon setup.StatIcon.SANITY>><</thought>><br>
		<<addSanity 15>>
		<<addLust -15>>
		<<run setTimeout(() => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }), 50)>>
	<</timed>>
<</widget>>

<<widget "tarotOblivion">>
	<<mc>>It's... all going dark... I... can't... hold on...<</mc>><br>
	@@.enterbtn; <<link "Let go" `setup.HuntController.huntOverPassage("sanity")`>>
	<</link>>@@
<</widget>>

<<widget "tarotKnowledge">>
	<<timed 2s>>
		<<run setup.HuntController.consumeKnowledgeEvidence()>>
		<<mc>>Knowledge? Hmm... interesting, that should be useful, right?<</mc>><br>
	<</timed>>
<</widget>>

<<widget "tarotPower">>
	<<timed 2s>>
		<<randRangeVideo "mechanics/cursedpossessions/power" 1 3 ".mp4">>
		<<run setTimeout(() => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }), 50)>>
		<<mc>>Wow, I can feel power surging through me! Oh, I'm ready to take on anything!<</mc>><br>
		@@.mc-thoughts; Energy increased: +5 <<statIcon setup.StatIcon.ENERGY>>@@<br>
		<<addEnergy 5>>
		<<addFit 1>>
	<</timed>>
<</widget>>

<<widget "tarotWhore">>
	<<timed 2s>>
		<<randRangeVideo "mechanics/cursedpossessions/whore" 1 6 ".mp4">>
		<<mc>>Damn, I can feel this affecting my body... everything's so sensitive, and some parts feel... bigger...<</mc>><br>
		<<run setTimeout(() => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }), 50)>>
	<</timed>>
<</widget>>

<<widget "tarotDeath">>
	<<mc>>This can't be a good card. Oh no, I'm scared...I need to hide somewhere!<</mc>><br>
	@@.enterbtn; <<link "Hide" "GhostProwlEvent">>
	<</link>>@@
	/* Once Death is drawn, Back and "Pull a card" both lead straight to
		the caught-during-prowl ending — only "Hide" escapes. */
	<<replace "#tarotCardsEnd">>
		<<link "@@.usebtn;Pull a card@@" `setup.HuntController.huntCaughtPassage()`>>
		<</link>>
	<</replace>>
	<<replace "#tarotBack">>
		@@.backbtn; <<link "Back" `setup.HuntController.huntCaughtPassage()`>>
		<</link>>@@
	<</replace>>
<</widget>>

<<widget "tarotPossession">>
	<<mc>>Oh fuck.<</mc>><br>
	@@.enterbtn; <<link "Give in" `setup.HuntController.possessionPassage()`>>
	<</link>>@@
	/* Once Possession is drawn, "Pull a card" and Back both lead straight
		to the possession outcome -- only "Give in" advances directly. Without
		this, the timed re-enable on .tarotCardHidden lets the player keep
		drawing past the possession and then exit the deck normally. */
	<<replace "#tarotCardsEnd">>
		<<link "@@.usebtn;Pull a card@@" `setup.HuntController.possessionPassage()`>>
		<</link>>
	<</replace>>
	<<replace "#tarotBack">>
		@@.backbtn; <<link "Back" `setup.HuntController.possessionPassage()`>>
		<</link>>@@
	<</replace>>
<</widget>>

<<widget "tarotHighpriestess">>
	<<timed 2s>>
		<<mc>>Looks like I'm still alive, and no one's about to attack me. I guess things aren't so bad.<</mc>><br>
		<<run setup.Ghosts.setHighPriestess(true)>>
	<</timed>>
<</widget>>
