:: WitchSale [nobr] {"position":"1350,150","size":"100,100"}
<div class="flexwrapper">
<div class="housecard">
<<hovertip "Sanity pills. Carry them in your bag and pop one during a hunt to top your sanity back up.">><<image "ui/img/sanity-pills.png" "iconPx">><</hovertip>><br>
<span class="priceAmount">30$</span><br>
<<if setup.Mc.money() gte 30>>
	@@.buyItemLink;<<link "Buy" "WitchSale">>
		<<run setup.Mc.addSanityPills(1)>>
		<<run setup.Mc.removeMoney(30)>>
	<</link>>@@<br>
<<else>>@@.mc-thoughts; I don't have enough money@@
<</if>>
<span class="subtitleAmount">@@.mc-thoughts; You have <<= setup.Mc.sanityPillsAmount()>> sanity pills@@</span>
</div>
<div class="housecard">
<<run setup.ToolController.initCrucifixIfNeeded()>>
<<hovertip "Crucifix. Burns up in your hand to block a ghost attack -- one use per crucifix.">><<image "ui/img/crucifix.webp" "iconPx">><</hovertip>><br>
<span class="priceAmount">50$</span><br>
<<if setup.Mc.money() gte 50>>
	@@.buyItemLink;<<link "Buy" "WitchSale">>
		<<run setup.ToolController.addCrucifix()>>
		<<run setup.Mc.removeMoney(50)>>
	<</link>>@@<br>
<<else>>@@.mc-thoughts; I don't have enough money@@
<</if>>
<span class="subtitleAmount">@@.mc-thoughts; You have <<= setup.ToolController.crucifixAmount()>> crucifix@@</span>
</div>
<div class="housecard">
<<if setup.Witch.toolLevel("emf") eq 5>>
	<<hovertip "EMF reader upgrade. Reads electromagnetic spikes when the ghost meddles with the room -- the better tier catches more spikes and stays lit longer.">><<image "ui/img/emf.png" "iconPx">><</hovertip>><br>
	<span class="priceAmount">200$</span><br>
	<<if setup.Mc.money() gte 200>>
		@@.buyItemLink;<<link "Buy (lvl 2)" "WitchSale">>
			<<run setup.Witch.upgradeTool("emf")>>
		<</link>>@@<br>
	<<else>>@@.mc-thoughts; I don't have enough money@@
	<</if>>
<</if>>
</div>
<div class="housecard">
<<if setup.Witch.toolLevel("temperature") eq 5>>
	<<hovertip "Thermometer upgrade. Reads the room temperature so you can pin down the High Temperature evidence -- the better tier shows a colored result.">><<image "ui/img/thermometr.png" "iconPx">><</hovertip>><br>
	<span class="priceAmount">100$</span><br>
	<<if setup.Mc.money() gte 100>>
		@@.buyItemLink;<<link "Buy (lvl 2)" "WitchSale">>
			<<run setup.Witch.upgradeTool("temperature")>>
		<</link>>@@<br>
	<<else>>@@.mc-thoughts; I don't have enough money@@
	<</if>>
<</if>>
</div>
<div class="housecard">
<<if setup.Witch.toolLevel("spiritbox") eq 5>>
	<<hovertip "Spirit box upgrade. Lets you ask a ghost questions and hear it answer through the static -- the better tier hits more often.">><<image "ui/img/spiritbox.png" "iconPx">><</hovertip>><br>
	<span class="priceAmount">500$</span><br>
	<<if setup.Mc.money() gte 500>>
		@@.buyItemLink;<<link "Buy (lvl 2)" "WitchSale">>
			<<run setup.Witch.upgradeTool("spiritbox")>>
		<</link>>@@<br>
	<<else>>@@.mc-thoughts; I don't have enough money@@
	<</if>>
<</if>>
</div>
<div class="housecard">
<<if setup.Witch.toolLevel("gwb") eq 5>>
	<<hovertip "Ghost-writing book upgrade. Left open in a room, it can catch the ghost putting pen to paper -- the better tier rolls more often.">><<image "ui/img/gwb.png" "iconPx">><</hovertip>><br>
	<span class="priceAmount">400$</span><br>
	<<if setup.Mc.money() gte 400>>
		@@.buyItemLink;<<link "Buy (lvl 2)" "WitchSale">>
			<<run setup.Witch.upgradeTool("gwb")>>
		<</link>>@@<br>
	<<else>>@@.mc-thoughts; I don't have enough money@@
	<</if>>
<</if>>
</div>
<div class="housecard">
<<if setup.Witch.toolLevel("glass") eq 5>>
	<<hovertip "Magnifying glass upgrade. Hunts for ectoplasm stains the ghost leaves behind -- the better tier spots them more reliably.">><<image "ui/img/glass.png" "iconPx">><</hovertip>><br>
	<span class="priceAmount">300$</span><br>
	<<if setup.Mc.money() gte 300>>
		@@.buyItemLink;<<link "Buy (lvl 2)" "WitchSale">>
			<<run setup.Witch.upgradeTool("glass")>>
		<</link>>@@<br>
	<<else>>@@.mc-thoughts; I don't have enough money@@
	<</if>>
<</if>>
</div>
<div class="housecard">
<<if setup.Witch.toolLevel("uvl") eq 5>>
	<<hovertip "UV light upgrade. Reveals ghost handprints on furniture and doors -- the better tier holds the glow longer per activation.">><<image "ui/img/uvl.png" "iconPx">><</hovertip>><br>
	<span class="priceAmount">400$</span><br>
	<<if setup.Mc.money() gte 400>>
		@@.buyItemLink;<<link "Buy (lvl 2)" "WitchSale">>
			<<run setup.Witch.upgradeTool("uvl")>>
