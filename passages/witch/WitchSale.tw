	<<else>>@@.mc-thoughts; I don't have enough money@@
	<</if>>
<</if>>
</div>
<div class="housecard">
<<if setup.MonkeyPaw.canBuyWishList()>>
	<<hovertip "A torn page listing every wish the monkey paw will grant. Names the wishes, not what each one costs you.">><<image "mechanics/cursedpossessions/monkey-paw/monkeypaw-page.jpg" "iconPx">><</hovertip>><br>
	@@.mc-thoughts; Monkey paw -- wishes list@@<br>
	<span class="priceAmount">400$</span><br>
	<<if setup.Mc.money() gte 400>>
		@@.buyItemLink;<<link "Buy" "WitchSale">>
			<<run setup.Witch.buyMonkeyPawWishList()>>
		<</link>>@@<br>
	<<else>>@@.mc-thoughts; I don't have enough money@@
	<</if>>
<</if>>
</div>
<div class="housecard">
<<if setup.MonkeyPaw.canBuyGuide()>>
	<<hovertip "The full grimoire entry on the monkey paw -- every wish and the price each one carries.">><<image "mechanics/cursedpossessions/monkey-paw/monkeypaw-page.jpg" "iconPx">><</hovertip>><br>
	@@.mc-thoughts; Monkey paw -- full guide@@<br>
	<span class="priceAmount">800$</span><br>
	<<if setup.Mc.money() gte 800>>
		@@.buyItemLink;<<link "Buy" "WitchSale">>
			<<run setup.Witch.buyMonkeyPawGuide()>>
		<</link>>@@<br>
	<<else>>@@.mc-thoughts; I don't have enough money@@
	<</if>>
<</if>>
</div>
<div class="housecard">
<<if not setup.Witch.detectorBought()>>
	<<hovertip "Paranormal detector. Highlights any furniture hiding cursed possessions, stolen clothes, or other tucked-away items.">><<image "ui/img/detector.png" "iconPx">><</hovertip>><br>
	<span class="priceAmount">200$</span><br>
	<<if setup.Mc.money() gte 200>>
		@@.buyItemLink;<<link "Buy" "WitchSale">>
			<<run setup.Witch.buyDetector()>>
		<</link>>@@<br>
	<<else>>@@.mc-thoughts; I don't have enough money@@
	<</if>>
<</if>>
</div>
