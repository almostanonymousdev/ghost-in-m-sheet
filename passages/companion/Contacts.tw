:: Contacts [nobr] {"position":"400,1000","size":"100,100"}
/* Per-companion contacts cards. Every companion-specific bit (portrait
   path, info passage, locked hint, possessed/with-rain transient hints,
   unlock predicate) comes from the catalogue entry, so a new companion
   just needs a CompanionData.js row and the card appears automatically. */
<div class="flexwrapper addGap5">
<<for _i, _c range setup.Companion.list()>>
	<div class="housecard">
		<<set _name to _c.name>>
		<<set _stats to setup.Companion.stateFor(_c.key)>>
		<<if setup.Companion.isUnlocked(_name) and _stats>>
			@@.notmc-speech; <<= _stats.name>> @@<br>
			<<= _stats.lvl>> lvl
			<<if _stats.lvl gte 5>> (max. lvl)
			<<else>>(<<= _stats.exp>> / <<= _stats.expForNextLvl>>)
			<</if>><br>
			<<image _c.portraitPath() "contactsImages">><br>
			<<if setup.Time.hours() lte 5>>
				<<if setup.Companion.hasFinishedSoloHunt(_name)>>
					@@.mc-thoughts; She is currently on a ghost hunt.@@
				<<else>>
					@@.mc-thoughts; She's sleeping@@<br>
				<</if>>
			<<elseif setup.Companion.isPossessed(_name)>>
				<<capture _c>>
					<<linkreplace "@@.enterbtn;Text her@@">><<= _c.possessedHint>>
					<</linkreplace>>
				<</capture>>
			<<elseif setup.Companion.isUnavailable(_name)>>
				@@.mc-thoughts;<<= _c.withRainHint>>@@
			<<else>>
				<<capture _c>>
					@@.enterbtn;<<link "Text her" `_c.infoPassage`>>
					<</link>>@@<br>
				<</capture>>
			<</if>>
		<<else>>
			@@.mc-thoughts; <<= _c.contactsLockedHint>>@@<br>
			<<image "ui/img/question-mark.png" "contactsImages">>
		<</if>>
	</div>
<</for>>
</div>
<br>
@@.backbtn; [[Back|Use PC]]@@<br>
